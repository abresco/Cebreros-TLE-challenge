"""
ESA Cebreros RFI Challenge
Satellite visibility analysis for RFI investigation
Checks which Earth-orbiting satellites were visible from Cebreros
during a specific time window (±10 minutes)

Author: Anusha
"""

import os
import csv
from skyfield.api import Topos, load
from datetime import datetime, timezone, timedelta

# -------------------------------------------------
# Ground station: Cebreros (Spain)
# -------------------------------------------------
station = Topos(
    latitude_degrees=40.4527,
    longitude_degrees=-4.3676,
    elevation_m=794
)

ts = load.timescale()

# -------------------------------------------------
# USER INPUT TIME (UTC) — Change per case
# Examples:
# BEPI → 2025-07-15 11:57
# MEX  → 2025-07-15 17:46
# SOLO → 2025-11-30 11:21
# -------------------------------------------------
target_time = datetime(2025, 11, 30, 11, 57, 0, tzinfo=timezone.utc)

print(f"\nAnalyzing satellites visible from Cebreros at {target_time} ±10 minutes\n")

# -------------------------------------------------
# Time window ±10 minutes
# -------------------------------------------------
start_time = target_time - timedelta(minutes=10)
end_time = target_time + timedelta(minutes=10)

# Create time range every 30 seconds
times_list = []
current = start_time
while current <= end_time:
    times_list.append(current)
    current += timedelta(seconds=30)

times = ts.from_datetimes(times_list)

# -------------------------------------------------
# Load multiple TLE files (Celestrak data)
# -------------------------------------------------
base_dir = os.path.dirname(__file__)

tle_files = ["active.tle", "geo.tle", "starlink.tle"]
satellites = []

for file in tle_files:
    tle_path = os.path.join(base_dir, "..", "Data", file)
    if os.path.exists(tle_path):
        sats = load.tle_file(tle_path)
        satellites.extend(sats)
        print(f"Loaded {len(sats)} satellites from {file}")

print(f"\nTotal satellites loaded: {len(satellites)}\n")

# -------------------------------------------------
# Prepare CSV output
# -------------------------------------------------
csv_file = open("satellite_pass_results.csv", "w", newline="")
writer = csv.writer(csv_file)

writer.writerow([
    "Satellite",
    "Time (UTC)",
    "Azimuth (deg)",
    "Elevation (deg)",
    "Distance (km)",
    "RFI Risk"
])

# -------------------------------------------------
# Analyze satellites
# -------------------------------------------------
visible_count = 0
rfi_candidates = 0

for satellite in satellites:

    difference = satellite - station
    topocentric = difference.at(times)

    alt, az, distance = topocentric.altaz()

    for i in range(len(times)):
        elevation = alt.degrees[i]

        # Satellite visible
        if elevation > 0:
            visible_count += 1

            # RFI Risk classification
            if elevation > 30:
                rfi_flag = "HIGH"
                rfi_candidates += 1
            elif elevation > 10:
                rfi_flag = "MEDIUM"
                rfi_candidates += 1
            else:
                rfi_flag = "LOW"

            print(
                f"{satellite.name} | "
                f"{times[i].utc_strftime('%H:%M:%S')} UTC | "
                f"Az={az.degrees[i]:.2f}° | "
                f"El={elevation:.2f}° | "
                f"Dist={distance.km[i]:.2f} km | "
                f"RFI Risk={rfi_flag}"
            )

            writer.writerow([
                satellite.name,
                times[i].utc_strftime('%H:%M:%S'),
                f"{az.degrees[i]:.2f}",
                f"{elevation:.2f}",
                f"{distance.km[i]:.2f}",
                rfi_flag
            ])

csv_file.close()

# -------------------------------------------------
# Summary
# -------------------------------------------------
print("\n----------------------------------")
print("Analysis Summary")
print("----------------------------------")
print(f"Total visible satellite points : {visible_count}")
print(f"Potential RFI candidates       : {rfi_candidates}")
print("Results saved to satellite_pass_results.csv")
print("----------------------------------")